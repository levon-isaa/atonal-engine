# systemd unit for Rota. deploy/setup.sh installs it; by hand:
#
#   sudo cp deploy/rota.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now rota
#
# Loopback only. TLS, body limits and slow-client timeouts belong to Caddy in front of it
# (deploy/Caddyfile, DEPLOY.md). Never set ROTA_HOST to a public address here.
[Unit]
Description=Rota booking server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rota
Group=rota
WorkingDirectory=/srv/rota/app
# Settings and the link-signing secret live here, root-owned and 0640, never in the repo.
EnvironmentFile=/etc/rota/rota.env
ExecStart=/usr/bin/python3 /srv/rota/app/server.py
Restart=always
RestartSec=3
# One process, a few threads, one SQLite file per studio. 512 MB is generous for hundreds of studios.
MemoryMax=512M

# --- hardening: read the code, write only the data folder ---
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/srv/rota/data

[Install]
WantedBy=multi-user.target
